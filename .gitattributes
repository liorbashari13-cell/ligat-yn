# Normalize line endings: store as LF in the repo, check out as-is.
# Silences the "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Explicitly treat binary assets so Git never tries to normalize them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
